@model Sea.Models.Fish

@if (Model == null)
{
    <p style="color:red;">Fish not found ❌</p>
}
else
{

    <div style="
        max-width:1100px;
        margin:auto;
        padding:30px;">

            <!-- صورة السمكة -->
            <img src="@Model.ImageUrl"
                 style="
                        width:100%;
                        height:450px;
                        object-fit:cover;
                        border-radius:20px;
                        box-shadow:0 4px 15px rgba(0,0,0,0.2);" />

            <!-- اسم السمكة -->
            <h1 style="
                    margin-top:25px;
                    font-size:40px;
                        color:#caf0f8;;">

                🐟 @Model.Name

            </h1>

            <!-- المعلومات -->
            <div style="
                    display:grid;
                    grid-template-columns:repeat(2, 1fr);
                    gap:20px;
                    margin-top:30px;">

            <div style="
        padding:20px;
        color:white;">

                    <h3>📍 Location</h3>
                    <p>@Model.Locations</p>

                </div>

            <div style="
        padding:20px;
        color:white;">

                    <h3>📏 Max Size</h3>
                    <p>@Model.MaxSize</p>

                </div>

            <div style="
        padding:20px;
        color:white;">

                    <h3>⏳ Max Age</h3>
                    <p>@Model.MaxAge</p>

                </div>

            <div style="
        padding:20px;
        color:white;">

                    <h3>🌊 Breeding Season</h3>
                    <p>@Model.BreedingSeason</p>

                </div>

            <div style="
        padding:20px;
        color:white;">

                    <h3>🍴 Edible</h3>
                    <p>@(Model.IsEdible ? "Yes" : "No")</p>

                </div>

            <div style="
        padding:20px;
        color:white;">

                    <h3>⚠ Dangerous</h3>
                    <p>@(Model.IsDangerous ? "Yes" : "No")</p>

                </div>

            </div>

            <!-- الوصف -->
        <div style="
        padding:20px;
        color:white;">

                <h2>📖 Description</h2>

                <p style="font-size:18px;">
                    @Model.Description
                </p>

            </div>

            <!-- الوقاية -->
        <div style="
        padding:20px;
        color:white;">

                <h2>🛡 Prevention</h2>

                <p style="font-size:18px;">
                    @Model.Prevention
                </p>

            </div>

            <!-- زر الرجوع -->
            <a asp-controller="Fish"
               asp-action="Index"
               style="
                        display:inline-block;
                        margin-top:30px;
                        background:#023e8a;
                        color:white;
                        padding:12px 20px;
                        border-radius:12px;
                        text-decoration:none;
                        font-size:18px;">

                ⬅ Back

            </a>

        </div>

}