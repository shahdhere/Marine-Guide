@{
    ViewData["Title"] = "Marine Dashboard";
}

<!-- ================= LOCATION SELECTOR ================= -->

<div class="row g-3 mb-4">

    <div class="col-12">

        <div class="card dashboard-card">

            <div class="card-body d-flex justify-content-between align-items-center">


                <div>
                    <h5 id="locationTitle">
                        📍 Current Location
                    </h5>

                    <h4 id="locationName">
                        Detecting location...
                    </h4>

                </div>


                <select id="locationSelect" class="form-select w-auto">

                    <option value="">
                        Change Location
                    </option>

                    <option value="27.0174,49.6225">
                        Jubail 🇸🇦
                    </option>

                    <option value="26.6424,50.1596">
                        Ras Tanura 🇸🇦
                    </option>

                    <option value="16.8892,42.5511">
                        Jazan 🇸🇦
                    </option>

                    <option value="24.0895,38.0618">
                        Yanbu 🇸🇦
                    </option>

                    <option value="17.2343,40.0071">
                        Al Lith 🇸🇦
                    </option>

                    <option value="16.7000,42.0000">
                        Farasan Islands 🇸🇦
                    </option>

                    <option value="28.4328,48.4937">
                        Khafji 🇸🇦
                    </option>

                    <option value="26.4207,50.0888">
                        Dammam 🇸🇦
                    </option>

                    <option value="26.2172,50.1971">
                        Al Khobar 🇸🇦
                    </option>

                    <option value="21.5433,39.1728">
                        Jeddah 🇸🇦
                    </option>

                    <option value="25.276987,55.296249">
                        Dubai 🇦🇪
                    </option>

                    <option value="-33.8688,151.2093">
                        Sydney 🇦🇺
                    </option>

                    <option value="35.6762,139.6503">
                        Tokyo 🇯🇵
                    </option>

                    <option value="41.3874,2.1686">
                        Barcelona 🇪🇸
                    </option>

                    <option value="-33.9249,18.4241">
                        Cape Town 🇿🇦
                    </option>

                    <option value="3.2028,73.2207">
                        Maldives 🇲🇻
                    </option>
                    <option value="25.2854,51.5310">
                        Doha 🇶🇦
                    </option>

                    <option value="25.7617,-80.1918">
                        Miami 🇺🇸
                    </option>

                </select>


            </div>

        </div>

    </div>

</div>


<div class="container-fluid">

   
    <!-- Cards Row -->
    <div class="row g-3 mb-4">



        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow dashboard-card">
                <div class="card-body text-center">

                    <h2 id="temperature">-- °C</h2>
                    <p>Temperature</p>

                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow dashboard-card">
                <div class="card-body text-center">

                    <h2 id="wind">-- m/s</h2>
                    <p>Wind Speed</p>

                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow dashboard-card">
                <div class="card-body text-center">

                    <h2 id="wave">-- m</h2>
                    <p>Wave Height</p>

                </div>
            </div>
        </div>


        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow dashboard-card">
                <div class="card-body text-center">

                    <h2 id="status">Loading...</h2>
                    <p>Safety</p>

                </div>
            </div>
        </div>

        <!-- Charts Row 1 -->
        <div class="row g-3 mb-4">


            <div class="col-12 col-lg-6">
                <div class="card shadow dashboard-card">
                    <div class="card-body">

                        <h5>
                            💨 Wind Speed
                        </h5>

                        <canvas id="windChart"></canvas>

                    </div>
                </div>

            </div>



            <div class="col-12 col-lg-6">
                <div class="card shadow dashboard-card">
                    <div class="card-body">

                        <h5>
                            🌊 Wave Height
                        </h5>

                        <canvas id="waveChart"></canvas>

                    </div>
                </div>

            </div>


        </div>




        <!-- Charts Row 2 -->
        <div class="row g-3 mb-4">


            <div class="col-12 col-lg-6">
                <div class="card shadow dashboard-card">
                    <div class="card-body">

                        <h5>
                            🌡 Temperature
                        </h5>

                        <canvas id="tempChart"></canvas>

                    </div>
                </div>

            </div>



            <div class="col-12 col-lg-6">
                <div class="card shadow dashboard-card">
                    <div class="card-body">

                        <h5>
                            🌧 Rain
                        </h5>

                        <canvas id="rainChart"></canvas>

                    </div>
                </div>

            </div>


        </div>




        <!-- RIGHT SIDE MAP -->
        <!-- Map + Tips -->

        <div class="row g-3">


            <div class="col-12 col-lg-8">
                <div class="card shadow dashboard-card">

                    <div class="card-body">

                        <h5>
                            🗺 Marine Map
                        </h5>


                        <div id="map" style="height:400px;"></div>


                    </div>

                </div>

            </div>



            <div class="col-12 col-lg-4">
                <div class="card shadow dashboard-card">

                    <div class="card-body">


                        <div class="safety-box">

                            <h5>
                                ⚠️ Safety Recommendations
                            </h5>


                            <div id="recommendation">
                                Checking marine conditions...
                            </div>


                        </div>


                    </div>

                </div>

            </div>
            </div>

        </div>
        </div>
@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


    <script>

        let windChart;
        let waveChart;
        let tempChart;
        let rainChart;


        // ================= MAP =================

        var map = L.map('map');


        L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            attribution:'&copy; OpenStreetMap contributors'

        }).addTo(map);



               // ================= LOCATION =================


        loadMarineLocation(function(lat, lon, name, isSelected){

            map.setView(
                [lat, lon],
                12
            );


            L.marker([lat, lon])
            .addTo(map)
            .bindPopup(name)
            .openPopup();



            // API

            getMarineData(lat, lon);



            document.getElementById("locationName")
            .innerHTML = name;
                    if(isSelected)
        {
            document.getElementById("locationTitle")
            .innerHTML =
            "📍 Selected Marine Area";
        }
        else
        {
            document.getElementById("locationTitle")
            .innerHTML =
            "📍 Current Location";
        }


        });


        // ================= API =================


        function getMarineData(lat,lon){


        fetch(`/api/weather/marine-status?type=boats&lat=${lat}&lon=${lon}`)


        .then(response=>response.json())


        .then(data=>{


        console.log(data);


        // Cards

        document.getElementById("wind").innerHTML =
        data.windSpeed.toFixed(1)+" m/s";


        document.getElementById("wave").innerHTML =
        data.waveHeight.toFixed(1)+" m";


        document.getElementById("temperature").innerHTML =
        data.temperature.toFixed(1)+" °C";


        document.getElementById("status").innerHTML =
        data.status;



        document.getElementById("recommendation").innerHTML =
               data.reasons
        .map(x=>{

            if(x.includes("wind"))
                return "💨 " + x;


            if(x.includes("wave"))
                return "🌊 " + x;


            if(x.includes("Avoid"))
                return "🚫 " + x;


            return "⚠️ " + x;


        })
        .join("<br>");



        updateCharts(data);



        })


        .catch(error=>{

        console.log("API Error:",error);

        });


        }






        // ================= CHARTS =================



        windChart = new Chart(
        document.getElementById("windChart"),
        {

        type:"line",

        data:{

        labels:[],

        datasets:[{

        label:"Wind Speed m/s",

        data:[],

        borderColor:"green",

        backgroundColor:"rgba(0,150,255,0.2)",

        fill:true,

        tension:0.4

        }]

        }

        });







        waveChart = new Chart(
        document.getElementById("waveChart"),
        {

        type:"line",

        data:{

        labels:[],

        datasets:[{

        label:"Wave Height m",

        data:[],

        borderColor:"blue",

        backgroundColor:"rgba(0,150,255,0.2)",

        fill:true,

        tension:0.4

        }]

        }

        });







        tempChart = new Chart(
        document.getElementById("tempChart"),
        {

        type:"line",

        data:{

        labels:[],

        datasets:[{

        label:"Temperature °C",

        data:[],

        borderColor:"orange",

        backgroundColor:"rgba(255,165,0,0.2)",

        fill:true,

        tension:0.4

        }]

        }

        });







        rainChart = new Chart(
        document.getElementById("rainChart"),
        {

        type:"bar",

        data:{

        labels:[],

        datasets:[{

        label:"Rain mm",

        data:[]

        }]

        }

        });






        // ================= UPDATE =================



        function updateCharts(data){


        let hours=[
        "1h","2h","3h","4h","5h","6h",
        "7h","8h","9h","10h","11h","12h",
        "13h","14h","15h","16h","17h",
        "18h","19h","20h","21h","22h","23h","24h"
        ];



        windChart.data.labels = hours;

        windChart.data.datasets[0].data =
        data.windHistory;




        waveChart.data.labels = hours;

        waveChart.data.datasets[0].data =
        data.waveHistory;




        tempChart.data.labels = hours;

        tempChart.data.datasets[0].data =
        data.temperatureHistory;




        // مؤقتاً لأن DTO لا يحتوي RainHistory

        rainChart.data.labels = ["Now"];

        rainChart.data.datasets[0].data =
        [data.rain];




        windChart.update();

        waveChart.update();

        tempChart.update();

        rainChart.update();


        }
        document.getElementById("locationSelect")
        .addEventListener("change", function(){


        if(this.value=="")
            return;


        let coords = this.value.split(",");


        let lat = parseFloat(coords[0]);
        let lon = parseFloat(coords[1]);


        let name =
        this.options[this.selectedIndex].text;


               // حفظ الموقع للجلسة الحالية
        sessionStorage.setItem(
            "marineLocation",
            JSON.stringify({
                lat: lat,
                lon: lon,
                name: name
            })
        );



        map.setView([lat,lon],13);



        L.marker([lat,lon])
        .addTo(map)
        .bindPopup(name)
        .openPopup();



        getMarineData(lat,lon);



        document.getElementById("locationName")
        .innerHTML=name;
                document.getElementById("locationTitle")
        .innerHTML =
        "📍 Selected Marine Area";

        });

    </script>

}